{
  "manifest_version": 3,
  "name": "Aikotoba",
  "version": "0.1.0",
  "description": "Two-factor authentication codes, sorted by name with your recent ones on top.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aikotoba@piro0919",
      "update_url": "https://aikotoba.kkweb.io/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "action": {
    "default_title": "Aikotoba",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ]
}
